{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/*.svg",
			"!drizzle/meta",
			"!project.inlang",
			"!**/openapi.json",
			"!node_modules",
			"!src/lib/paraglide",
			"!static",
			"!.svelte-kit",
			"!build",
			"!dist",
			"!test-results",
			"!playwright-report",
			"!playwright-report*",
			"!drizzle",
			"!.github"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"html": {
		"formatter": {
			"indentScriptAndStyle": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"globals": ["Bun"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": "error",
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 80
					}
				},
				"noImplicitCoercions": "off",
				"noRedundantDefaultExport": "off",
				"noVoid": "off",
				"useMaxParams": "error"
			},
			"correctness": {
				"noNodejsModules": "off",
				"noUnresolvedImports": "off",
				"noUnusedImports": "warn",
				"useImportExtensions": "off",
				"useQwikValidLexicalScope": "off"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"recommended": true,
				"useExplicitType": "off",
				"useSortedClasses": "error"
			},
			"performance": {
				"noAwaitInLoops": "off",
				"noBarrelFile": "off",
				"noNamespaceImport": "off",
				"noReExportAll": "off",
				"useTopLevelRegex": "off"
			},
			"preset": "all",
			"security": {
				"noSecrets": "off"
			},
			"style": {
				"noContinue": "off",
				"noEnum": "off",
				"noDefaultExport": "off",
				"noExcessiveClassesPerFile": "off",
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 680
					}
				},
				"noExportedImports": "off",
				"noHexColors": "off",
				"noImplicitBoolean": "off",
				"noIncrementDecrement": "off",
				"noMagicNumbers": "off",
				"noNamespace": "off",
				"noNegationElse": "off",
				"noNestedTernary": "off",
				"noParameterProperties": "off",
				"noProcessEnv": "off",
				"noTernary": "off",
				"useAtIndex": "off",
				"useBlockStatements": "error",
				"useComponentExportOnlyModules": "off",
				"useConsistentArrayType": "off",
				"useConsistentMemberAccessibility": "off",
				"useConsistentTypeDefinitions": "error",
				"useDestructuring": "off",
				"useErrorCause": "off",
				"useExplicitLengthCheck": "off",
				"useExportsLast": "off",
				"useGlobalThis": "off",
				"useNamingConvention": "off",
				"useSingleVarDeclarator": "off"
			},
			"suspicious": {
				"noBitwiseOperators": "off",
				"noConsole": "error",
				"noEmptyBlockStatements": "error",
				"noEqualsToNull": "off",
				"noImportCycles": "off",
				"noReactSpecificProps": "off",
				"noReturnAssign": "off",
				"noShadow": "off",
				"noUnnecessaryConditions": "error",
				"useAwait": "error",
				"useStaticResponseMethods": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off",
						"useHookAtTopLevel": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"suspicious": {
						"noEmptySource": "off"
					}
				}
			}
		},
		{
			"includes": [
				"e2e/**",
				"scripts/**",
				"test.setup.ts",
				"**/*.test.ts",
				"**/*.spec.ts",
				"**/*.config.ts",
				"**/*.config.js",
				"**/*.config.mjs"
			],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off"
					},
					"performance": {
						"noAwaitInLoops": "off"
					},
					"style": {
						"noExcessiveLinesPerFile": "off",
						"noIncrementDecrement": "off",
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noConsole": "off",
						"noEmptyBlockStatements": "off",
						"noExplicitAny": "off",
						"noSkippedTests": "off",
						"useAwait": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/docs/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/docs/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					},
					"suspicious": {
						"noUnnecessaryConditions": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/logger.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/lib/server/auth/index.ts",
				"src/lib/server/config.ts",
				"src/lib/server/openapi/define-route.ts",
				"src/lib/server/openapi/registry.ts"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noFloatingPromises": "off",
						"noMisusedPromises": "off"
					},
					"suspicious": {
						"noUnnecessaryConditions": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/api/v1.d.ts", "src/lib/server/db/schema.ts"],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": "off"
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
