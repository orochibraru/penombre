{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		// `bun:test` globals for src/lib/content.test.ts. The generated
		// SvelteKit tsconfig this extends doesn't know about them.
		"types": ["bun"]
	},
	"extends": "./.svelte-kit/tsconfig.json"
}
