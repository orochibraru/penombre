#!/usr/bin/env bash
#MISE description="Build the Android app and run it on the connected phone or emulator"
#MISE dir="mobile"
set -e
./gradlew -q :androidApp:assembleDebug
adb wait-for-device
# The device's localhost reaches `bun run dev` on this machine.
adb reverse tcp:5173 tcp:5173
adb install -r androidApp/build/outputs/apk/debug/androidApp-debug.apk
adb shell am start -n com.orochibraru.penombre/dev.penombre.app.MainActivity
