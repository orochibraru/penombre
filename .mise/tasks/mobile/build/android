#!/usr/bin/env bash
#MISE description="Build the Android APK and Play bundle, signed when ANDROID_KEYSTORE_FILE names the key"
set -e
cd apps/mobile
./gradlew -q :androidApp:assembleRelease :androidApp:bundleRelease
ls -1 androidApp/build/outputs/apk/release/*.apk androidApp/build/outputs/bundle/release/*.aab | sed 's|^|apps/mobile/|'
