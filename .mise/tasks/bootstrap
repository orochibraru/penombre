#!/usr/bin/env bash
#MISE description="Get a fresh clone ready to run: dependencies, git hooks, generated messages, a warm worker build"
set -e
bun install
# Gitignored and otherwise only written by the Vite plugin: `bun test` needs it.
bun run gen:paraglide
# The dev server builds the worker at start, and a cold build takes minutes.
go -C apps/worker build -o /dev/null ./cmd/worker
