{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"rangeStrategy": "pin",
	"extends": ["config:recommended"],
	"packageRules": [
		{
			"description": "svelte-check refuses TypeScript 7 until it ships tsgo support",
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<7"
		},
		{
			"description": "2.5.14 reports every null check on RegExp.exec as unnecessary",
			"matchPackageNames": ["@biomejs/biome"],
			"allowedVersions": "!/^2\\.5\\.14$/"
		},
		{
			"matchUpdateTypes": ["pin", "digest"],
			"automerge": true
		},
		{
			"groupName": "Bun & JavaScript Ecosystem",
			"matchManagers": ["bun", "npm"],
			"groupSlug": "bun-js-monorepo",
			"matchPackageNames": ["*"]
		},
		{
			"groupName": "Docker & Compose Infrastructure",
			"matchManagers": ["dockerfile", "docker-compose"],
			"groupSlug": "docker-infra",
			"matchPackageNames": ["*"]
		},
		{
			"groupName": "GitHub Actions",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["*"]
		},
		{
			"matchDepTypes": ["devDependencies"],
			"automerge": true,
			"labels": ["dependencies", "devDependencies"]
		}
	],
	"bun": {
		"enabled": true
	},
	"labels": ["dependencies"],
	"assignees": ["orochibraru"]
}
