{
	"config": {
		"default": true,
		"MD013": {
			"code_blocks": false,
			"headings": false,
			"line_length": 80,
			"tables": false
		},
		"MD028": false
	},
	"fix": true,
	"globs": ["**/*.md", "!**/node_modules/**"],
	"ignores": [
		"**/node_modules",
		"build",
		"CHANGELOG.md",
		"dist",
		"project.inlang",
		"src/lib/paraglide",
		"src/paraglide",
		"test-results",
		"playwright-report",
		// The PostgreSQL run writes its report beside the SQLite one, and its
		// generated markdown is not ours to lint.
		"playwright-report-pg"
	]
}
