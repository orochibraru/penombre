{
	"config": {
		"default": true,
		"MD013": {
			"code_blocks": false,
			"headings": false,
			"line_length": 80,
			"tables": false
		},
		"MD028": false
	},
	"fix": true,
	"globs": ["**/*.md", "!**/node_modules/**"],
	"ignores": [
		"**/node_modules",
		"build",
		"CHANGELOG.md",
		"dist",
		// Vendored native dependencies (CocoaPods / Gradle), not ours to format.
		"packages/mobile/.expo",
		"packages/mobile/android",
		"packages/mobile/ios",
		"project.inlang",
		"src/lib/paraglide",
		"src/paraglide",
		"test-results"
	]
}
