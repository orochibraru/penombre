	"keywords": [],
	"license": "MIT",
	"name": "penombre",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"backup": "./scripts/backup.sh",
		"build": "svelte-kit sync && vite build",
		"check": "bun run --parallel check:app check:packages",
		"check:app": "bun run gen:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:docs": "bun run --filter @penombre/docs check",
		"check:mobile": "bun run --filter @penombre/mobile check",
		"check:packages": "bun run --parallel check:docs check:scripts",
		"check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
		"circular": "bun run ./scripts/circular.ts",
		"db:diagram": "bun run ./scripts/db-diagram.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"dev": "bun --env-file .env concurrently.config.ts",
		"dev:app": "vite dev",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"format:md": "prettier --log-level warn --write \"**/*.md\"",
		"gen:api": "bun run ./scripts/gen-api.ts",
		"gen:env": "bun run ./scripts/generate-env-example.ts",
		"gen:openapi": "bun run ./scripts/generate-openapi.ts && openapi-typescript ./src/lib/api/v1.json -o ./src/lib/api/v1.d.ts && bunx biome check --write ./src/lib/api/v1.d.ts",
		"gen:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie baseLocale",
		"lint": "bun run --parallel lint:ts lint:md lint:tailwind",
		"lint:fix": "bun run --parallel lint:fix:md lint:fix:tailwind && bun run lint:fix:ts",
		"lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
		"lint:fix:tailwind": "tailwint --fix",
		"lint:fix:ts": "biome check --write --unsafe",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"lint:tailwind": "tailwint",
		"lint:ts": "biome check",
		"machine-translate": "inlang machine translate --project project.inlang",
		"migrate:storage": "bun run ./scripts/migrate-storage-meta.ts",
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true; prek install -t pre-commit -t commit-msg --allow-missing-config || true",
		"preview": "vite preview",
		"release": "semantic-release",
		"restore": "./scripts/restore.sh",
		"test:docker": "docker compose -f compose.test.yaml up --build --exit-code-from test --abort-on-container-exit",
		"test:e2e": "docker compose -f compose.e2e.yaml -p penombre-e2e build && playwright test --config=playwright.local.config.ts",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:local": "docker compose -f compose.e2e.yaml -p penombre-e2e build && playwright test --config=playwright.local.config.ts",
		"test:e2e:s3": "docker compose -f compose.e2e.yaml --profile s3 -p penombre-e2e-s3 build && playwright test --config=playwright.config.ts",
		"test:e2e:ui": "playwright test --ui"
	},
	"type": "module",
	"version": "1.8.19",
	"workspaces": [
		"packages/*"
	]
}
