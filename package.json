{
	"name": "penombre",
	"version": "1.8.68",
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "bun run check:app && bun run check:scripts",
		"check:app": "bun run gen:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:scripts": "bun check --no-script -p tsconfig.scripts.json",
		"circular": "bun .mise/tasks/web/circular.ts",
		"db:generate": "bun run db:generate:pg && bun run db:generate:sqlite",
		"db:generate:pg": "drizzle-kit generate",
		"db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "vite dev",
		"gen": "bun run gen:env && bun run gen:api",
		"gen:api": "bun run gen:openapi",
		"gen:env": "bun .mise/tasks/web/gen/env.ts",
		"gen:openapi": "bun .mise/tasks/web/gen/openapi-spec.ts && openapi-typescript ./openapi.json -o ./src/lib/api/v1.d.ts && bun fmt ./src/lib/api/v1.d.ts",
		"gen:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie baseLocale",
		"lint": "prek run --all-files",
		"machine-translate": "inlang machine translate --project project.inlang",
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true; git config --unset core.hooksPath; prek install --allow-missing-config || true",
		"preview": "vite preview",
		"test:docker": "docker compose -f tools/docker/compose.test.yaml --project-directory . up --build --exit-code-from test --abort-on-container-exit",
		"test:e2e": "sh -c 'if [ -n \"$E2E_IMAGE\" ]; then docker compose -f tools/docker/compose.e2e.yaml --project-directory . -p penombre-e2e up --wait --no-build; else docker compose -f tools/docker/compose.e2e.yaml --project-directory . -p penombre-e2e up --build --wait; fi' && playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:headed": "playwright test --config tests/e2e/playwright.config.ts --headed",
		"test:e2e:pg": "E2E_PORT=3002 E2E_DATABASE_URL=postgresql://postgres:postgres@db:5432/penombre_e2e E2E_ENCRYPTION_KEY=$(printf penombre-e2e-encryption-test-key | base64) sh -c 'if [ -n \"$E2E_IMAGE\" ]; then docker compose -f tools/docker/compose.e2e.yaml --project-directory . --profile pg -p penombre-e2e-pg up --wait --no-build; else docker compose -f tools/docker/compose.e2e.yaml --project-directory . --profile pg -p penombre-e2e-pg up --build --wait; fi' && playwright test --config tests/e2e/playwright.pg.config.ts",
		"test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
		"screenshots": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/screenshots"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.14",
		"@better-auth/passkey": "1.7.14",
		"@kitql/helpers": "0.8.15",
		"@lucide/svelte": "1.66.0",
		"@soundtouchjs/audio-worklet": "2.1.1",
		"better-auth": "1.7.14",
		"drizzle-orm": "0.45.4",
		"drizzle-zod": "0.8.3",
		"ioredis": "6.0.0",
		"marked": "18.1.2",
		"mode-watcher": "1.1.0",
		"nodemailer": "10.1.4",
		"openapi-fetch": "0.17.0",
		"paneforge": "1.0.2",
		"pdf-lib": "1.17.1",
		"pdfmake": "0.3.13",
		"postgres": "4.0.0",
		"prosekit": "0.23.0",
		"reflect-metadata": "0.2.2",
		"svelte-sonner": "1.2.2",
		"swagger-ui-dist": "5.34.1",
		"uqr": "0.1.3",
		"uuid": "14.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@inlang/cli": "3.4.5",
		"@inlang/paraglide-js": "2.29.3",
		"@j178/prek": "0.5.9",
		"@playwright/test": "1.64.1",
		"@shikijs/langs": "4.5.0",
		"@shikijs/themes": "4.5.0",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/language-server": "0.16.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.4.4",
		"@types/madge": "5.0.3",
		"@types/node": "26.6.6",
		"@types/nodemailer": "8.0.2",
		"@types/pdfmake": "0.3.3",
		"@vite-pwa/sveltekit": "1.1.0",
		"agnix": "0.60.2",
		"bits-ui": "2.20.2",
		"clsx": "2.1.1",
		"drizzle-kit": "0.31.11",
		"madge": "8.0.0",
		"markdownlint-cli2": "0.24.0",
		"openapi-typescript": "7.13.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"runed": "0.38.0",
		"shiki": "4.5.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"svelte-toolbelt": "0.10.6",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "4.3.3",
		"tailwint": "1.1.16",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"packageManager": "bun@1.4.4",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"trustedDependencies": [
		"agnix"
	]
}
