{
	"name": "penombre",
	"version": "1.8.47",
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "bun run check:app && bun run check:scripts",
		"check:app": "bun run gen:paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
		"circular": "bun run ./scripts/circular.ts",
		"db:generate": "bun run db:generate:pg && bun run db:generate:sqlite",
		"db:generate:pg": "drizzle-kit generate",
		"db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "vite dev",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"format:md": "prettier --log-level warn --write \"**/*.md\"",
		"gen": "bun run gen:env && bun run gen:api && bun run format",
		"gen:api": "bun run ./scripts/gen-api.ts",
		"gen:env": "bun run ./scripts/generate-env-example.ts",
		"gen:openapi": "bun run ./scripts/generate-openapi.ts && openapi-typescript ./openapi.json -o ./src/lib/api/v1.d.ts && bunx biome check --write ./src/lib/api/v1.d.ts",
		"gen:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie baseLocale",
		"lint": "bun run lint:ts && bun run lint:md && bun run lint:tailwind",
		"lint:fix": "bun run lint:fix:md && bun run lint:fix:tailwind && bun run lint:fix:ts",
		"lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
		"lint:fix:tailwind": "tailwint --fix \"src/**/*.{svelte,css,html,ts}\"",
		"lint:fix:ts": "biome check --write --unsafe .",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"lint:tailwind": "tailwint \"src/**/*.{svelte,css,html,ts}\"",
		"lint:ts": "biome check",
		"machine-translate": "inlang machine translate --project project.inlang",
		"migrate:storage": "bun run ./scripts/migrate-storage-meta.ts",
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true; prek install -t pre-commit -t commit-msg -t post-checkout --allow-missing-config || true",
		"preview": "vite preview",
		"release": "semantic-release",
		"test:docker": "docker compose -f compose.test.yaml up --build --exit-code-from test --abort-on-container-exit",
		"test:e2e": "sh -c 'if [ -n \"$E2E_IMAGE\" ]; then docker compose -f compose.e2e.yaml -p penombre-e2e up --wait --no-build; else docker compose -f compose.e2e.yaml -p penombre-e2e up --build --wait; fi' && playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:pg": "E2E_PORT=3002 E2E_DATABASE_URL=postgresql://postgres:postgres@db:5432/penombre_e2e sh -c 'if [ -n \"$E2E_IMAGE\" ]; then docker compose -f compose.e2e.yaml --profile pg -p penombre-e2e-pg up --wait --no-build; else docker compose -f compose.e2e.yaml --profile pg -p penombre-e2e-pg up --build --wait; fi' && playwright test --config=playwright.pg.config.ts",
		"test:e2e:ui": "playwright test --ui",
		"screenshots": "playwright test --config playwright.config.ts e2e/screenshots"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.5",
		"@better-auth/passkey": "^1.7.5",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@kitql/helpers": "^0.8.15",
		"@lucide/svelte": "^1.47.0",
		"archiver": "^8.0.0",
		"better-auth": "^1.7.5",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"ioredis": "^6.0.0",
		"mode-watcher": "^1.1.0",
		"music-metadata": "^11.15.0",
		"nodemailer": "^10.0.10",
		"openapi-fetch": "^0.17.0",
		"paneforge": "1.0.2",
		"postgres": "^3.4.9",
		"prosekit": "^0.22.2",
		"reflect-metadata": "^0.2.2",
		"sharp": "^0.35.4",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"swagger-ui-dist": "^5.33.0",
		"tw-animate-css": "^1.4.0",
		"uuid": "^14.0.2",
		"vaul-svelte": "1.0.0-next.7",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@inlang/cli": "^3.3.7",
		"@inlang/paraglide-js": "^2.25.4",
		"@orochibraru/svelte-smol": "^1.6.1",
		"@playwright/test": "^1.63.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"@sveltejs/kit": "^3.0.0-next.27",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/archiver": "^8.0.0",
		"@types/bun": "^1.4.2",
		"@types/madge": "^5.0.3",
		"@types/node": "^26.6.1",
		"@types/nodemailer": "^8.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"madge": "^8.0.0",
		"markdownlint": "^0.41.1",
		"markdownlint-cli2": "^0.23.2",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.8",
		"runed": "^0.37.1",
		"semantic-release": "^25.0.9",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.16",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"packageManager": "bun@1.4.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
