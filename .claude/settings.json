{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && bun fmt --cwd \"$CLAUDE_PROJECT_DIR\" --ignore-unknown --no-error-on-unmatched-pattern --log-level warn \"$f\"; }",
						"timeout": 20,
						"statusMessage": "bun fmt"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun run check:app",
						"timeout": 90,
						"statusMessage": "Typechecking before handing back..."
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"svelte@svelte": true
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	}
}
